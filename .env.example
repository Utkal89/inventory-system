# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=inventory

# Backend (used by docker-compose for backend service)
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/inventory

# Frontend: URL where the backend API is accessible
# For local dev: http://localhost:8000
# For production: https://your-backend-on-render.onrender.com
REACT_APP_API_URL=http://localhost:8000
